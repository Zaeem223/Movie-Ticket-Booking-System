<Page Background="Wheat" x:Class="TicketsBookingApp.AdminPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:TicketsBookingApp"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="AdminPage">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="80"/>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="230"/>
            <ColumnDefinition/>
            <ColumnDefinition Width="230"/>
        </Grid.ColumnDefinitions>

        <Button Content="Movies" Grid.Column="1" Grid.Row="1" FontSize="36" FontWeight="Bold" Click="MoviesButton" Margin="10" />
        <Button Content="Shows" Grid.Column="1" Grid.Row="2" FontSize="36" FontWeight="Bold" Click="ShowsButton" Margin="10"/>
        <Button Content="Bookings" Grid.Column="1" Grid.Row="3" FontSize="36" FontWeight="Bold" Click="BookingsButton" Margin="10" />

        <Button Grid.Column="2" Width="75" Height="27" HorizontalAlignment="Right" VerticalAlignment="Top" Content="Sign out" Click="SignOutButton" FontWeight="Bold"> </Button>
        <!--<StackPanel HorizontalAlignment="Left" Height="302" Margin="212,96,0,0" VerticalAlignment="Top" Width="346">
            <Button Content="Movies" HorizontalAlignment="Center" VerticalAlignment="Center" Width="183" Height="72" FontSize="22" FontWeight="Bold"/>
            <Button Content="Shows" HorizontalAlignment="Center" VerticalAlignment="Center" Width="183" Height="72" FontSize="22" FontWeight="Bold"/>
            <Button Content="Bookings" HorizontalAlignment="Center" VerticalAlignment="Center" Width="183" Height="72" FontSize="22" FontWeight="Bold"/>
        </StackPanel>-->
    </Grid>
</Page>
