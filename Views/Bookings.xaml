<Page  Background="DarkGray" x:Class="TicketsBookingApp.Bookings" 
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:TicketsBookingApp"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="MyBookingsList">

    <Grid >
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="30*"/>
            <ColumnDefinition Width="20*"/>
            <ColumnDefinition Width="15*"/>
            <ColumnDefinition Width="40*"/>
            <ColumnDefinition Width="40*"/>
            <ColumnDefinition Width="40*"/>
            <ColumnDefinition Width="40*"/>
            <ColumnDefinition Width="70*"/>
            <ColumnDefinition Width="60*"/>

        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="36*"/>
            <RowDefinition Height="20*"/>
            <RowDefinition Height="20*"/>
            <RowDefinition Height="250*"/>
            <RowDefinition Height="30*"/>
            <RowDefinition Height="30*"/>
            <RowDefinition Height="50*"/>
        </Grid.RowDefinitions>

        <DataGrid x:Name="dgBookings" Visibility="Visible" SelectionMode="Single" IsReadOnly="True"
          AutoGenerateColumns="False" Grid.ColumnSpan="6" Grid.Row="3" Grid.Column="2"   >
            <DataGrid.Columns>
                <DataGridTextColumn Header="Id" Width="150"
                                    Binding="{Binding BookingId}" />
                <DataGridTextColumn Header="Movie" Width="150"
                                    Binding="{Binding MovieName}" />

                <DataGridTextColumn Header="Cinema" Width="150"
                                    Binding="{Binding CinemaName}" />

                <DataGridTextColumn Header="Tickets" Width="150"
                                    Binding="{Binding NoOfTickets}" />
                <DataGridTextColumn Header="ShowDateTime" Width="150"
                                    Binding="{Binding ShowDateAndTime}" />

                <DataGridTextColumn Header="Booking DateTime" Width="150"
                                    Binding="{Binding BookingTime}" />


                <DataGridTextColumn Header="Total Price" Width="Auto"
                                    Binding="{Binding Price}" />


            </DataGrid.Columns>


        </DataGrid>
        <Label Content="Bookings" HorizontalAlignment="Center"  VerticalAlignment="Center" Width="180" FontSize="25" FontWeight="Bold" Grid.Column="4" Grid.Row="0" Height="42"   Grid.ColumnSpan="3" />
        <Button Content="Back" HorizontalAlignment="Left" VerticalAlignment="Top" Width="75" FontSize="18" FontWeight="Bold" Click="Back_Click_1" Height="27" />










        <StackPanel Grid.Column="4"
            Grid.Row="1"
            Grid.ColumnSpan="2"
            Orientation="Horizontal"
            VerticalAlignment="Bottom"
            HorizontalAlignment="Center">

            <TextBlock Text="Movie"
               Width="85"
               TextAlignment="Center"
               FontWeight="Bold" Margin="5,0,0,0"/>

            <TextBlock Text="Cinema"
               Width="85"
               TextAlignment="Center"
               FontWeight="Bold"
               Margin="5,0,0,0"/>

        </StackPanel>





        <Button Content="Sign out" HorizontalAlignment="Right"  VerticalAlignment="Top" Width="70" Height="27" Click="Button_Click" FontWeight="Bold" Grid.Column="8" />


        <StackPanel Grid.Row="2"
            Grid.Column="3"
            Grid.ColumnSpan="4"
            Orientation="Horizontal"
            HorizontalAlignment="Center"
            VerticalAlignment="Center">

            <Button Content="Search" Margin="5,0,0,0" HorizontalAlignment="Center" VerticalAlignment="Top" Width="65"  Click="SearchButton_Click"  Grid.Row="2" Grid.Column="3" Height="20"  />

            <TextBox x:Name="MoviesTextBox" Margin="5,0,0,0" MaxLength="50" HorizontalAlignment="Center" Height="20"  TextWrapping="Wrap" Text="" VerticalAlignment="Top" Width="85" Grid.Row="2" Grid.Column="4"    />
            <ComboBox x:Name="CinemaCombo" Margin="5,0,0,0" HorizontalAlignment="Center"  VerticalAlignment="Top" Width="85"  Grid.Row="2" Grid.Column="5" Height="20" >
                <ComboBoxItem Content="Cineplex Central"/>
                <ComboBoxItem Content="Grand Cinema"/>
                <ComboBoxItem Content="Galaxy Cinemas" />
                <ComboBoxItem Content="Royal Screens" />
                <ComboBoxItem Content="Star Cinema" />
            </ComboBox>
            <Button Content="Clear" Margin="5,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" Width="70"  Click="ClearSearchButton_Click" Grid.Row="2" Grid.Column="6" Height="20"  />
        </StackPanel>

        <Label x:Name="BookingsLabel"  Visibility="Hidden" Grid.Column="5" Grid.Row="4" Grid.ColumnSpan="2" Content="Zaeem" HorizontalAlignment="Left"  VerticalAlignment="Top" Height="32" Width="170" FontSize="16" FontWeight="Bold" Background="#FFF1F1F1"/>
        <Label x:Name="TicketsSold" Visibility="Hidden"  Grid.Column="5" Grid.Row="5" Grid.ColumnSpan="2" Content="" HorizontalAlignment="Left"  VerticalAlignment="Top" Width="170" Height="32" FontSize="16" FontWeight="Bold" Background="#FFF1F1F1"/>
        <Label x:Name="SalesLabel" Visibility="Hidden"  Grid.Column="5" Grid.Row="6" Grid.ColumnSpan="2" Content="" HorizontalAlignment="Left" VerticalAlignment="Top" Width="170" Height="32" FontSize="16" FontWeight="Bold" Background="#FFF1F1F1" RenderTransformOrigin="0.509,0.313"/>

        <StackPanel Grid.Row="4" Grid.Column="1" HorizontalAlignment="Center" Orientation="Horizontal" Grid.ColumnSpan="4"  VerticalAlignment="Center"  >
            <Label Content="From"  Width="50" FontSize="14" FontWeight="Bold" />
            <DatePicker x:Name= "StartingDate" Width="112" />
        </StackPanel>

        <StackPanel Grid.Row="5" Grid.Column="1" HorizontalAlignment="Center" Orientation="Horizontal" Grid.ColumnSpan="4" VerticalAlignment="Top">
            <Label Content="To" HorizontalAlignment="Left"  VerticalAlignment="Top" Width="50" FontSize="14" FontWeight="Bold" Grid.Column="1" Grid.Row="5"/>
            <DatePicker x:Name="EndingDate" HorizontalAlignment="Left"  VerticalAlignment="Top" Width="112" Grid.Row="5" Grid.Column="3"/>
        </StackPanel>
        <StackPanel Grid.Row="6" Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" Grid.ColumnSpan="4" VerticalAlignment="Top">
            <Button Content="Sales Report"  HorizontalAlignment="Left"  VerticalAlignment="Top" Width="70"  Click="SalesReportButton_Click" Height="26" FontWeight="Bold" Grid.Column="1" Grid.Row="6" Grid.ColumnSpan="2" FontSize="11"/>
            <Button Content="Clear" Margin="5,0,0,0" HorizontalAlignment="Center"  VerticalAlignment="Top" Width="60" Height="26" FontWeight="Bold" Click="clearButton_Click" Grid.Column="3" Grid.Row="6" FontSize="11"/>
        </StackPanel>


        <StackPanel  Grid.Row="5" Grid.Column="7" HorizontalAlignment="Center" Orientation="Horizontal"  VerticalAlignment="Top">
            <Button  HorizontalAlignment="Left"  VerticalAlignment="Bottom" Width="23" Click="decButton_Click_1" Content="&lt;" FontWeight="Bold" FontSize="16" Grid.Column="5" Height="25" Grid.Row="5"  />
            <Label x:Name="PagesCount" Content="1 of 1" HorizontalAlignment="Center"  VerticalAlignment="Bottom" Grid.Column="5" Height="25" Grid.Row="5" Width="40" />
            <Button  HorizontalAlignment="Right"  VerticalAlignment="Bottom" Width="23" Click="IncButton_Click_1" Content="&gt;" FontWeight="Bold" FontSize="16" Grid.Column="5" Height="25" Grid.Row="5"   />
        </StackPanel>
    </Grid>
</Page>
