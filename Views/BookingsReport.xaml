<Page Background="DarkGray" x:Class="TicketsBookingApp.BookingsReport"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:TicketsBookingApp"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="BookingsReport">
    <Grid>
        <DataGrid x:Name="dgBookings"
          Width="800"
          Height="343"
          HorizontalAlignment="Left"
          VerticalAlignment="Top"
          AutoGenerateColumns="False" SelectionChanged="dgBookings_SelectionChanged" Margin="0,40,0,0">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Id" Width="40"
                        Binding="{Binding BookingId}" />

                <DataGridTextColumn Header="Customer Name" Width="96"
                        Binding="{Binding UserName}" />

                <DataGridTextColumn Header="Show" Width="80" 
                        Binding="{Binding MovieName}" />

                <DataGridTextColumn Header="Cinema" Width="80"
                        Binding="{Binding CinemaName}" />

                <DataGridTextColumn Header="Tickets" Width="40"
                        Binding="{Binding NoOfTickets}" />

                <DataGridTextColumn Header="ShDateTime" Width="80"
                        Binding="{Binding ShowDateAndTime}" />

                <DataGridTextColumn Header="Show Status" Width="80"
                        Binding="{Binding ShowStatus}" />

                <DataGridTextColumn Header="BDateTime" Width="80"
                        Binding="{Binding BookingTime}" />

                <DataGridTextColumn Header="Booking Status" Width="80"
                        Binding="{Binding BookingStatus}" />

                <DataGridTextColumn Header="Price" Width="80"
                        Binding="{Binding Price}" />

            </DataGrid.Columns>
        </DataGrid>
        <Label Content="Bookings Report :" HorizontalAlignment="Left" Margin="239,0,0,0" VerticalAlignment="Top" Width="287" FontSize="22" FontWeight="Bold"/>
        <Button Content="Back" HorizontalAlignment="Left" VerticalAlignment="Top" Width="75" Height="34"/>
    </Grid>
</Page>
