<Page Background="DarkKhaki" x:Class="TicketsBookingApp.CreatePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:TicketsBookingApp"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="CreatePage">

    <Grid RenderTransformOrigin="0.491,0.498" Margin="0,0,0,-0.4">
        <Grid.RowDefinitions>
            <RowDefinition Height="69*"/>
            <RowDefinition Height="20*"/>
            <RowDefinition Height="20*"/>
            <RowDefinition Height="20*"/>
            <RowDefinition Height="20*"/>
            <RowDefinition Height="20*"/>
            <RowDefinition Height="20*"/>
            <RowDefinition Height="50*"/>
            <RowDefinition Height="50*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="250*"/>
            <ColumnDefinition Width="100*"/>
            <ColumnDefinition Width="120*"/>
            <ColumnDefinition Width="250*"/>
        </Grid.ColumnDefinitions>



        <StackPanel Orientation="Horizontal" Grid.Column="1" Grid.Row="4" Grid.ColumnSpan="2">
        <Label Content="Location" HorizontalAlignment="Left"  VerticalAlignment="Center"  Width="102" FontWeight="Bold" FontSize="16" Grid.Column="1" Height="32" Grid.Row="4"  />
        <TextBox x:Name="location" MaxLength="50" HorizontalAlignment="Left" Height="20"  TextWrapping="Wrap" Text="" VerticalAlignment="Center" Width="120"  Grid.Column="2" Grid.Row="4" />
        </StackPanel>
        <StackPanel Orientation="Horizontal" Grid.Column="1" Grid.Row="7" Grid.ColumnSpan="2" HorizontalAlignment="Left" Margin="30,0,0,0">
        <Button Content="Create" Background="#0078D7" HorizontalAlignment="Center"  VerticalAlignment="Center" Width="152"  FontSize="14" Click="CreateAccountButton" Grid.Column="1" Height="22" Grid.ColumnSpan="2" Grid.Row="7" Margin="0,0,50,0" />
        </StackPanel>
        <StackPanel Orientation="Horizontal" Grid.Column="1" Grid.Row="5" Grid.ColumnSpan="2">
        <Label Content="Password" HorizontalAlignment="Left"  VerticalAlignment="Center"  Width="102" FontWeight="Bold" FontSize="16" Grid.Column="1" Height="32" Grid.Row="5"   />
        <PasswordBox  x:Name="PasswordBox" MaxLength="14" HorizontalAlignment="Left"  PasswordChar="*" VerticalAlignment="Center" Width="120" Height="20" Grid.Column="2" Grid.Row="5"  />
        </StackPanel>
        <StackPanel Orientation="Horizontal" Grid.Column="1" Grid.Row="3" Grid.ColumnSpan="2">
        <Label Content="Gmail" HorizontalAlignment="Left"  VerticalAlignment="Center"  Width="102" FontWeight="Bold" FontSize="16" Grid.Column="1" Height="32" Grid.Row="3"   />
        <TextBox x:Name="emailBox" MaxLength="50" HorizontalAlignment="Left" Height="20"  TextWrapping="Wrap" Text="" VerticalAlignment="Center" Width="120"  Grid.Column="2" Grid.Row="3"     />
        </StackPanel>
        <StackPanel Orientation="Horizontal" Grid.Column="1" Grid.Row="2" Grid.ColumnSpan="2">
        <Label Content="CNIC" HorizontalAlignment="Left"  VerticalAlignment="Center"  Width="102" FontWeight="Bold" FontSize="16" Grid.Column="1" Height="32" Grid.Row="2"   />
        <TextBox x:Name="cnic_Box" MaxLength="25" PreviewTextInput="TicketsTextBox_PreviewTextInput" HorizontalAlignment="Left" Height="20"  TextWrapping="Wrap" Text="" VerticalAlignment="Center" Width="120"  Grid.Column="2" Grid.Row="2"     />
        </StackPanel>
        <StackPanel Orientation="Horizontal" Grid.Column="1" Grid.Row="1" Grid.ColumnSpan="2">
        <Label Content="User Name"  HorizontalAlignment="Left"  VerticalAlignment="Center"  Width="102" FontWeight="Bold" FontSize="16" Grid.Column="1" Height="32" Grid.Row="1"     />
            <TextBox x:Name="userName_Box" MaxLength="30" HorizontalAlignment="Left" Height="20"  TextWrapping="Wrap" Text="" VerticalAlignment="Center" Width="120"  Grid.Column="2" Grid.Row="1"   >
            </TextBox>
        </StackPanel>
        <StackPanel Orientation="Horizontal" Grid.Column="1" Grid.Row="6" Grid.ColumnSpan="2">
        <Label Content="Gender" HorizontalAlignment="Left"  VerticalAlignment="Center"  Width="102" FontWeight="Bold" FontSize="16" Grid.Column="1" Height="32" Grid.Row="6"    />
        <RadioButton x:Name="Male" Content="Male" GroupName="Gender" HorizontalAlignment="Left"  VerticalAlignment="Center" Grid.Column="2" Height="15" Width="45" Grid.Row="6"   />
        <RadioButton x:Name="Female"
             Content="Female"
             GroupName="Gender"
             VerticalAlignment="Center"
             Grid.Column="2"
             Height="15"
             Width="65"
             Grid.Row="6"
             HorizontalAlignment="Center"
Margin="10,0,0,0"
                     />
        </StackPanel>
        <Label Content="Create Account" HorizontalAlignment="Left"  VerticalAlignment="Center"  Width="225" Height="42" FontSize="29" FontWeight="Bold" Grid.ColumnSpan="2" Grid.Column="1"  />
        <Button Content="Back" HorizontalAlignment="Left" VerticalAlignment="Top" Grid.Column="0" Width="65" Grid.Row="0" Height="25" FontWeight="Bold" Click="BackClick"> </Button>
    </Grid>
</Page>
