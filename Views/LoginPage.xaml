<Page x:Class="TicketsBookingApp.LoginPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:TicketsBookingApp"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="LoginPage">

    <Grid Background="LightSteelBlue" x:Name="Check">
        <Grid.RowDefinitions>
            <RowDefinition Height="40*"/>
            <RowDefinition Height="30*"/>
            <RowDefinition Height="50*"/>
            <RowDefinition Height="28*"/>
            <RowDefinition Height="28*"/>
            <RowDefinition Height="48*"/>
            <RowDefinition Height="80*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="55*"/>
            <ColumnDefinition Width="31*"/>
            <ColumnDefinition Width="35*"/>
            <ColumnDefinition Width="66*"/>
            <ColumnDefinition Width="55*"/>
        </Grid.ColumnDefinitions>




        <StackPanel Orientation="Horizontal" Grid.Column="2" Grid.Row="3" Grid.ColumnSpan="2">
            <Label Content="User Name" HorizontalAlignment="Left"  VerticalAlignment="Center"  Width="100" FontWeight="Bold" FontSize="14" Grid.Column="2"  Grid.Row="3"/>
            <TextBox x:Name="userName" MaxLength="30" HorizontalAlignment="Left" Height="19"  TextWrapping="Wrap" Text="" VerticalAlignment="Center" Width="120"  Grid.Column="3"  Grid.Row="3"/>
        </StackPanel>
        <Separator Grid.Column="1" Grid.Row="2" Grid.ColumnSpan="3" VerticalAlignment="Bottom"></Separator>
        <Button Content="Login" Background="#0078D7" HorizontalAlignment="Left" Margin="30,0,0,0"  VerticalAlignment="Top" Width="172"  FontSize="14" Click="LoginButton" Grid.ColumnSpan="2"  Grid.Row="5"  Grid.Column="2"/>

        <StackPanel Orientation="Horizontal" Grid.Column="2" Grid.Row="4" Grid.ColumnSpan="2">
            <Label Content="Password" HorizontalAlignment="Left"  Margin="0,-5,0,0" VerticalAlignment="Top"  Width="100" FontWeight="Bold" FontSize="14" Grid.Column="2"  Grid.Row="4" Grid.ColumnSpan="2"/>
            <PasswordBox  x:Name="PasswordBox" MaxLength="14" HorizontalAlignment="Left"  PasswordChar="*" VerticalAlignment="Top" Width="120" Height="19" Grid.Column="3" Grid.Row="4"/>
        </StackPanel>

        <Label Content="Login to Get Started" HorizontalAlignment="Left"  VerticalAlignment="Bottom"  Width="231" FontWeight="Bold" FontSize="22" Height="38" Grid.ColumnSpan="2" Grid.Column="2"  Grid.Row="1"/>
        <StackPanel Orientation="Horizontal" Grid.Column="2" Grid.Row="2" Grid.ColumnSpan="2">
            <Label Content="Dont have Account?" Margin="0,-5,0,0" HorizontalAlignment="Left"  VerticalAlignment="Top"  Width="120" FontWeight="Bold" FontSize="11"  Grid.Column="2"  Grid.Row="2"  />
            <Button Content="Create Account" Background="LightGray"  Foreground="Blue" HorizontalAlignment="Left"  VerticalAlignment="Top" Width="75"  FontSize="10" BorderThickness="0" 
        FocusVisualStyle="{x:Null}" Click="CreateAccount_Click" Grid.Column="3"  Grid.Row="2"  />
        </StackPanel>

    </Grid>
</Page>
