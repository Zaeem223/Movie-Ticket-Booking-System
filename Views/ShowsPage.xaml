<Page Background="DarkGray" x:Class="TicketsBookingApp.ShowsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:sys="clr-namespace:System;assembly=mscorlib"
      xmlns:local="clr-namespace:TicketsBookingApp"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="AdminPage">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="70*"/>
            <ColumnDefinition Width="90*"/>
            <ColumnDefinition Width="90*"/>
            <ColumnDefinition Width="70*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="27*"/>
            <RowDefinition Height="41*"/>
            <RowDefinition Height="20*"/>
            <RowDefinition Height="210*"/>
            <RowDefinition Height="31*"/>
            <RowDefinition Height="31*"/>
            <RowDefinition Height="31*"/>
            <RowDefinition Height="74*"/>

        </Grid.RowDefinitions>
        <!--<Grid.ColumnDefinitions>
            <ColumnDefinition Width="503*"/>
            <ColumnDefinition Width="297*"/>
        </Grid.ColumnDefinitions>-->




        <DataGrid x:Name="dgShowslist"
          IsReadOnly="True"
          SelectionMode="Single"
          SelectionUnit="FullRow"
          AutoGenerateColumns="False"
         
          Grid.Row="3"
          Grid.ColumnSpan="6" >




            <DataGrid.Columns>
                <DataGridTextColumn Header="Show Name"
                            Width="150"
                            Binding="{Binding showName}" />

                <DataGridTextColumn Header="Cinema Name"
                            Width="150"
                            Binding="{Binding CinemaName}" />

                <DataGridTextColumn Header="Show Date Time"
                            Width="150"
                            Binding="{Binding BDateTime}" />
                <DataGridTextColumn Header="Tickets"
                            Width="150"
                            Binding="{Binding Tickets}" />
                <DataGridTextColumn Header="Ticket Price"
                            Width="150"
                            Binding="{Binding ticketPrice}" />
                <DataGridTextColumn Header="Genre"
                            Width="150"
                            Binding="{Binding Genre}" />

                <DataGridTextColumn Header="Duration"
                            Width="150"
                            Binding="{Binding Duration}" />

                <DataGridTextColumn Header="Language"
                            Width="100"
                            Binding="{Binding Language}" />



                <DataGridTextColumn Header="Description"
                            Width="Auto"
                            Binding="{Binding Description}" />


            </DataGrid.Columns>




        </DataGrid>

        <!--<Label Content="Movie Name :" x:Name="MovieNameLabel" HorizontalAlignment="Left" Margin="362,15,0,0" VerticalAlignment="Top" Width="428" Height="40" Visibility="Visible" FontWeight="Bold" FontSize="16"/>
            <Label Content="Description :" x:Name="DescriptionLbael" HorizontalAlignment="Left" Margin="363,241,0,0" VerticalAlignment="Top" Width="427" Height="76" Visibility="Visible" FontWeight="Bold" FontSize="16"/>
            <Label Content="Ticket Price :" x:Name="TicketPriceLabel" HorizontalAlignment="Left" Margin="363,196,0,0" VerticalAlignment="Top" Width="427" Height="40" Visibility="Visible" FontWeight="Bold" FontSize="16"/>
            <Label Content="Language :" x:Name="LanguageLabel" HorizontalAlignment="Left" Margin="363,151,0,0" VerticalAlignment="Top" Width="412" Height="40" Visibility="Visible" FontWeight="Bold" FontSize="16"/>
            <Label Content="Duration :" x:Name="DurationLabel" HorizontalAlignment="Left" Margin="363,106,0,0" VerticalAlignment="Top" Width="427" Height="40" Visibility="Visible" FontWeight="Bold" FontSize="16"/>
            <Label Content="Genre :" x:Name="GenreLabel" HorizontalAlignment="Left" Margin="363,60,0,0" VerticalAlignment="Top" Width="355" Height="41" Visibility="Visible" FontWeight="Bold" FontSize="16"/>
            <Label Content="Date and Time :" x:Name="DateTimeLabel" HorizontalAlignment="Left" Margin="362,308,0,0" VerticalAlignment="Top" Width="316" Height="34" Visibility="Visible" FontWeight="Bold" FontSize="16"/>-->
        <!--<Button Content="View Details" Visibility="Hidden" HorizontalAlignment="Left" Margin="0,355,0,0" VerticalAlignment="Top" Width="93" Height="27" RenderTransformOrigin="1.508,0.674" FontSize="14" FontWeight="Bold"  Click="ViewDetailsButton_Click_1"/>-->

        <Label Content="No of Tickets :" x:Name="MovieNameLabel_Copy6" HorizontalAlignment="Left"  VerticalAlignment="Top" Width="92" Height="30" Visibility="Hidden" FontWeight="Bold" RenderTransformOrigin="0.504,1.173" Grid.Row="5"/>
        <Label Content="Search by: " HorizontalAlignment="Left" VerticalAlignment="Top"  FontSize="16"  FontWeight="Bold" Visibility="Hidden" Height="32" Grid.RowSpan="2" Width="91" Grid.ColumnSpan="2"/>

        <Button Content="Sign out" HorizontalAlignment="Right"  VerticalAlignment="Top" Width="75" Height="27" Click="Button_Click" FontWeight="Bold" Grid.Column="5" />

        <TextBlock  HorizontalAlignment="Left"  TextWrapping="Wrap" Text="Shows: " VerticalAlignment="Bottom" Height="43" Width="121" FontSize="36" FontWeight="Bold" Grid.Row="1" Grid.RowSpan="2" Grid.Column="0" TextDecorations="{x:Null}" FontFamily="Georgia"/>





        <StackPanel Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="5" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Top">
            <Button Content="Search" HorizontalAlignment="Right"  VerticalAlignment="Top" Width="75" Click="SearchButton_Click" FontWeight="Bold" Height="20" Grid.Row="2" />
            <TextBox x:Name="MoviesTextBox" MaxLength="50" HorizontalAlignment="Center" Height="20"  Margin="5,0,0,0" TextWrapping="Wrap" Text="" VerticalAlignment="Top" Width="85" Grid.Row="2" Grid.Column="1"  />
            <ComboBox x:Name="CinemaCombo"  HorizontalAlignment="Center"  VerticalAlignment="Top" Width="85"  Margin="5,0,0,0" Height="20" Grid.Row="2" Grid.Column="2" >
                <ComboBoxItem Content="Cineplex Central"/>
                <ComboBoxItem Content="Grand Cinema"/>
                <ComboBoxItem Content="Galaxy Cinemas" />
                <ComboBoxItem Content="Royal Screens" />
                <ComboBoxItem Content="Star Cinema" />
            </ComboBox>
            <ComboBox x:Name="GenreCombo" HorizontalAlignment="Center"  Margin="5,0,0,0" VerticalAlignment="Top" Width="85" Height="20" Grid.Row="2" Grid.Column="3" >
                <ComboBoxItem Content="Action"/>
                <ComboBoxItem Content="Adventure"/>
                <ComboBoxItem Content="Comedy" />
                <ComboBoxItem Content="Horror" />
                <ComboBoxItem Content="Romance" />
            </ComboBox>
            <Button Content="Clear"  Margin="5,0,0,0" HorizontalAlignment="Center" VerticalAlignment="Top" Width="75" Click="ClearSearchButton_Click" Height="20" Grid.Row="2" Grid.Column="4" />
        </StackPanel>
        <StackPanel VerticalAlignment="Bottom" Grid.Column="0" Grid.Row="1" Orientation="Horizontal" Grid.ColumnSpan="5" HorizontalAlignment="Center">
            <TextBlock Text=""
               Width="75"/>
            <TextBlock Text="Movie"
               Width="85"
               TextAlignment="Center"
               FontWeight="Bold"
               Margin="5,0,0,0"/>

            <TextBlock Text="Cinema"
               Width="85"
               TextAlignment="Center"
               FontWeight="Bold"
               Margin="5,0,0,0"/>

            <TextBlock Text="Genre"
               Width="85"
               TextAlignment="Center"
               FontWeight="Bold"
               Margin="5,0,0,0"/>
            <TextBlock Text=""
               Width="75"
               Margin="5,0,0,0"/>
        </StackPanel>
        <StackPanel Grid.Column="0" Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Center">
            <Button   VerticalAlignment="Center" Width="30" Click="decButton_Click_1" Content="&lt;" FontWeight="Bold" FontSize="16" Height="25" Grid.Row="4" Grid.Column="2" />
            <Label x:Name="PagesCount" Content="1 of 1" HorizontalAlignment="Center"  VerticalAlignment="Center" Height="25" Grid.Row="4" Width="40" Grid.Column="2" />
            <Button    VerticalAlignment="Center" Width="30" Click="IncButton_Click_1" Content="&gt;" FontWeight="Bold" FontSize="16" Height="25" Grid.Row="4" Grid.Column="2"  />
        </StackPanel>


        <StackPanel Grid.Column="1" Grid.Row="4" Orientation="Horizontal" Grid.ColumnSpan="2" >

            <Label x:Name="MoviesLabel" Content="Movies" HorizontalAlignment="Left" Width="80" VerticalAlignment="Center" FontSize="16"/>
            <ComboBox x:Name="MoviesComboBox" HorizontalAlignment="Left"  VerticalAlignment="Center" Width="120"   />
            <Label x:Name="CinemasLabel" Margin="5,0,0,0" Content="Cinemas" HorizontalAlignment="Left"  VerticalAlignment="Center" Width="100" FontSize="16"/>
            <ComboBox x:Name="CinemaComboBox" HorizontalAlignment="Left"  VerticalAlignment="Center" Width="120" />
        </StackPanel>

        <StackPanel Grid.Column="1" Grid.Row="5" Orientation="Horizontal" Grid.ColumnSpan="2">
            <Label Content="Tickets"  HorizontalAlignment="Left" Width="80"  VerticalAlignment="Center" FontSize="16"/>
            <TextBox x:Name="TicketsTextBox" MaxLength="10" PreviewTextInput="TicketsTextBox_PreviewTextInput" HorizontalAlignment="Left" Height="23"  TextWrapping="Wrap" VerticalAlignment="Center" Width="120"/>
            <Label Content="Date"  HorizontalAlignment="Left" Width="100"  VerticalAlignment="Center" FontSize="16" Margin="5,0,0,0"/>
            <DatePicker x:Name="ShowDatePicker" DisplayDateStart="{x:Static sys:DateTime.Today}"  HorizontalAlignment="Left"  VerticalAlignment="Center"/>
        </StackPanel>

        <StackPanel Grid.Column="1" Grid.Row="6" Orientation="Horizontal" Grid.ColumnSpan="2">
            <Label Content="Price" HorizontalAlignment="Left" Width="80"  VerticalAlignment="Center" FontSize="16" />
            <TextBox x:Name="PriceTextBox"  MaxLength="10"  PreviewTextInput="TicketsTextBox_PreviewTextInput" HorizontalAlignment="Left" Height="23" TextWrapping="Wrap" VerticalAlignment="Center" Width="120" />
            <Label Content="Time" HorizontalAlignment="Left" Width="100" Margin="5,0,0,0" VerticalAlignment="Center" FontSize="16" />
            <ComboBox x:Name="cmbTime" Width="120"    SelectedValuePath="Content" IsEditable="True"
          Height="23"
          HorizontalAlignment="Left"
          VerticalAlignment="Center"
           >
                <ComboBoxItem Content="10:00"/>
                <ComboBoxItem Content="13:00"/>
                <ComboBoxItem Content="19:00"/>
                <ComboBoxItem Content="22:00"/>
            </ComboBox>
        </StackPanel>
        <StackPanel Grid.Row="7" Grid.Column="1" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Left" Margin="30,0,0,0"  >
            <Button  Content="Add"  Width="75" Click="AddButton_Click_2" FontSize="16" FontWeight="Bold" Height="25"  />
            <Button Content="Delete"  Width="75" Click="DeleteButton_Click" FontSize="16" FontWeight="Bold" Height="25" Margin="5,0,0,0" />
            <Button Content="Clear"  Width="75" FontSize="16" FontWeight="Bold" Click="ClearButton_Click_" Height="25" Margin="5,0,0,0"/>
            <Button Content="Edit"   Width="82" FontSize="16" FontWeight="Bold" Click="EditShowButton_Click_2" Height="25" Margin="5,0,0,0"/>
            <Button Content="Update"  Width="75" Click="UpdateButton_Click" FontSize="16" FontWeight="Bold" Height="25" Margin="5,0,0,0" />
        </StackPanel>


        <Button Content="Back" Width="50" Height="27" FontWeight="Bold" HorizontalAlignment="Left" VerticalAlignment="Top" Click="Button_Click_1"></Button>
    </Grid>
</Page>
