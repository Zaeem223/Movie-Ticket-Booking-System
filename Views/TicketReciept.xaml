<Page Background="LightYellow" x:Class="TicketsBookingApp.TicketReciept"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:TicketsBookingApp"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="TicketReciept">

    <Grid>

        <!--<Border Width="350" Background="Wheat" Padding="15" Grid.Column="1" >-->
        <!--<TextBlock Text="Ticket Receipt" HorizontalAlignment="Center" FontWeight="Bold" FontSize="18"  />-->
        <!--<Grid>-->
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="300*"/>
            <ColumnDefinition Width="150*"/>
            <ColumnDefinition Width="250*" />
            <ColumnDefinition Width="300*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="50*"/>
            <RowDefinition Height="70*"/>
            <RowDefinition Height="20*"/>
            <RowDefinition Height="20*"/>
            <RowDefinition Height="20*"/>
            <RowDefinition Height="20*"/>
            <RowDefinition Height="20*"/>
            <RowDefinition Height="20*"/>
            <RowDefinition Height="20*"/>
            <RowDefinition Height="20*"/>
            <RowDefinition Height="20*"/>
            <RowDefinition Height="20*"/>
            <RowDefinition Height="60*"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Ticket Receipt" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold" FontSize="22" Grid.ColumnSpan="2" Grid.Row="1" Grid.Column="1" />
        <TextBlock Text="Booking ID:" Grid.Row="3" FontWeight="Bold" FontSize="16" HorizontalAlignment="Left" Grid.Column="1"/>
        <TextBlock Text="Customer:" Grid.Row="4" FontWeight="Bold" FontSize="16" HorizontalAlignment="Left" Grid.Column="1"/>
        <TextBlock Text="Cinema:" Grid.Row="7" FontWeight="Bold" FontSize="16" HorizontalAlignment="Left" Grid.Column="1"/>
        <TextBlock Text="Show Date:" Grid.Row="6" FontWeight="Bold" FontSize="16" HorizontalAlignment="Left" Grid.Column="1"/>
        <TextBlock Text="Show Name:" Grid.Row="5" FontWeight="Bold" FontSize="16" HorizontalAlignment="Left" Grid.Column="1"/>
        <TextBlock Text="Tickets:" Grid.Row="8" FontWeight="Bold" FontSize="16" HorizontalAlignment="Left" Grid.Column="1"/>
        <TextBlock Text="Price:" Grid.Row="9" FontWeight="Bold" FontSize="16" HorizontalAlignment="Left" Grid.Column="1"/>
        <TextBlock Text="Booking on:" Grid.Row="10" FontWeight="Bold" FontSize="16" HorizontalAlignment="Left" Grid.Column="1"/>
        <TextBlock x:Name="BookingIdTextBlock" Text="" Grid.Row="3" Grid.Column="2" FontWeight="Bold" FontSize="16" HorizontalAlignment="Left"/>
        <TextBlock x:Name="CustomerTextBlock"  Text="" Grid.Row="4" Grid.Column="2" FontWeight="Bold" FontSize="16" HorizontalAlignment="Left"/>
        <TextBlock x:Name="CinemaTextBlock" Grid.Row="7" Grid.Column="2" FontWeight="Bold" FontSize="16" HorizontalAlignment="Left"/>
        <TextBlock x:Name="ShowDateTextBlock" Grid.Row="6" Grid.Column="2" FontWeight="Bold" FontSize="16" HorizontalAlignment="Left"/>
        <TextBlock x:Name="ShowNameTextBlock" Grid.Row="5" Grid.Column="2" FontWeight="Bold" FontSize="16" HorizontalAlignment="Left"/>
        <TextBlock x:Name="TicketsTextBlock" Grid.Row="8" Grid.Column="2" FontWeight="Bold" FontSize="16" HorizontalAlignment="Left"/>
        <TextBlock x:Name="PriceTextBlock" Grid.Row="9" Grid.Column="2" FontWeight="Bold" FontSize="16" HorizontalAlignment="Left" Height="25" Grid.RowSpan="2" VerticalAlignment="Top"/>
        <TextBlock x:Name="BookingonTextBlock" Grid.Row="10" Grid.Column="2" FontWeight="Bold" FontSize="16" HorizontalAlignment="Left"/>
        <!--<TextBlock Text="Thank You For Booking" Grid.Row="10" Grid.ColumnSpan="2" FontWeight="Bold" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Top"/>-->
        <Button Content="Download" FontWeight="Bold" VerticalAlignment="Top" FontSize="16" Grid.Row="12" Height="25" Width="90" HorizontalAlignment="Right" Grid.Column="1" Click="Download_Click_1"/>
        <Button Content="Close" FontWeight="Bold" VerticalAlignment="Top" FontSize="16" Grid.Row="12" Height="25" Grid.Column="2" Width="90" HorizontalAlignment="Left" Click="Close_Click" Margin="20,0,0,0"/>
        <Separator Grid.Row="11"
                   Grid.ColumnSpan="2" Grid.Column="1"
                  />
        <Separator Grid.Row="2"
                   Grid.ColumnSpan="2" Grid.Column="1"
                  />
    </Grid>
</Page>
